# Postgres connection used by the running app
DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5432/todo

# Separate Postgres database used only by the test suite (pytest)
DATABASE_URL_TEST=postgresql+asyncpg://todo:todo@localhost:5432/todo_test

# Random secret used to sign the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-random-secret

# Base URL of the running frontend, used for CORS and post-login redirect
FRONTEND_URL=http://localhost:5173

# Google OAuth (OpenID Connect) app credentials
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth app credentials
# https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# When true, registers POST /auth/test-login which mocks an SSO provider
# response without contacting Google/GitHub. Used by the automated test
# suite. Leave false for a normal local run.
ENABLE_TEST_AUTH=false

# When true, registers POST /api/dev/seed which creates sample data for the
# current user. Safe to leave true for local development.
ENABLE_DEV_ENDPOINTS=true

# Default interval (seconds) between periodic WebSocket notification checks.
# A connected client may override this via a "subscribe" message, clamped to
# 10-300 seconds server-side.
WS_CHECK_INTERVAL_DEFAULT=30
